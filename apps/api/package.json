{
  "name": "@tgim/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "pnpm build && TGIM_IN_MEMORY=true node --test --test-concurrency=1 test/*.test.mjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@fastify/cors": "^9.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.14.0",
    "@tgim/shared": "workspace:*",
    "bullmq": "^6.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "sarvamai": "^1.1.8",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
