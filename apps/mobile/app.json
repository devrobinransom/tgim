{
  "expo": {
    "name": "TGIM",
    "slug": "tgim",
    "scheme": "tgim",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ff5200"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.tgim.app"
    },
    "android": {
      "package": "org.tgim.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
